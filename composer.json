{
    "name": "basemotive/phersist",
    "type": "library",
    "description": "A tiny PHP-ORM",
    "keywords": ["ORM"],
    "homepage": "https://phersist.dev/",
    "license": "LGPL-2.1-or-later",
    "minimum-stability": "dev",
    "authors": [
        {
            "name": "Stefan Mensink",
            "email": "stefan@basemotive.nl",
            "homepage": "https://www.basemotive.nl/",
            "role": "Lead Developer"
        }
    ],
    "bin": [
		"bin/phersist"
    ],
    "require": {
        "php": ">=8.1.0"
    },
    "autoload": {
        "psr-4" : {
            "PHersist\\" : "src/"
        }
    },
    "autoload-dev": {
        "psr-4" : {
            "Tests\\Support\\" : "tests/Support/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "jetbrains/phpstorm-stubs": "dev-master",
        "pestphp/pest": "^4"
    },
    "scripts": {
        "test": "pest",
        "test:all": [
            "Composer\\Config::disableProcessTimeout",
            "tests/docker/run.sh"
        ],
        "test:db": [
            "Composer\\Config::disableProcessTimeout",
            "tests/docker/run.sh"
        ]
    },
    "scripts-descriptions": {
        "test": "Runs the tests on SQLite, on this machine",
        "test:all": "Runs the tests on every database, in Docker",
        "test:db": "Runs the tests on the given targets, in Docker (composer test:db -- mysql-8.4 sqlite)"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
