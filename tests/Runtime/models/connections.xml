<project database="main" tablestyle="SnakeCase" namespace="Tests\Models\Connections">
	<!--
		A class with its own database (ConnectionTest), and references to it.

		conn_remotes is in the "other" database, the rest in the main one (ids are INT, auto-increment):
		- conn_locals:   id, name (text), remote_id (ConnRemote, on delete: null)
		- conn_blockers: id, remote_id (ConnRemote, required: restrict)
		- conn_remotes:  id, name (text)
	-->
	<class name="ConnLocal">
		<dataset autoload="true">
			<property name="name"/>
			<property name="remote" type="Class" class="ConnRemote"/>
		</dataset>
	</class>
	<class name="ConnBlocker">
		<dataset autoload="true"><property name="remote" type="Class" class="ConnRemote" required="true"/></dataset>
	</class>
	<class name="ConnRemote" database="other">
		<dataset autoload="true"><property name="name"/></dataset>
	</class>
</project>
