<project database="main" tablestyle="SnakeCase" namespace="Fixture\Types">
	<!-- Every property type, with defaults, column names and reference options -->
	<schema dialect="mysql" charset="latin1"/>

	<class name="Item">
		<dataset autoload="true">
			<property name="title" required="true" default="It's a \ 'test' */"/>
			<property name="notes"/>
			<property name="count" type="Int" default="-3"/>
			<property name="stock" type="Int" signed="false" required="true" default="0"/>
			<property name="ratio" type="Float" default="1.5"/>
			<property name="price" type="Decimal" precision="12" scale="4" default="9.99"/>
			<property name="amount" type="Decimal"/>
			<property name="active" type="Bool" required="true" default="true"/>
			<property name="hidden" type="Bool" default="false"/>
			<property name="birthday" type="Date"/>
			<property name="createdAt" type="DateTime" required="true" update_on="create"/>
			<property name="modifiedAt" type="DateTime" update_on="modify"/>
			<property name="stamp" type="TimestampText" update_on="modify"/>
			<property name="customStamp" type="TimestampText" date_format="d-m-Y"/>
			<property name="owner" type="Class" class="Owner" fieldname="owner_ref"/>
			<property name="creator" type="Class" class="Owner" required="true" on_remote_delete="cascade"/>
			<property name="subject" type="DynamicClass" on_remote_delete="restrict"/>
			<property name="target" type="DynamicClass" use_namespace="true" fieldnames="target_class,target_ref"/>
			<property name="external" type="Class" class="\Other\Lib\Thing"/>
		</dataset>
	</class>

	<class name="Owner">
		<dataset>
			<property name="name"/>
		</dataset>
	</class>
</project>
